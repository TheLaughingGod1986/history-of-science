      "window_t1": 135.296,
      "window_s": 5.203000000000003,
      "used_s": 5.2,
      "explorer": true,
      "quality": "Fast",
      "vo_land": "Every element has its own number, and that number is the order of the periodic table. It isn't a list of weights. It's a count."
    },
