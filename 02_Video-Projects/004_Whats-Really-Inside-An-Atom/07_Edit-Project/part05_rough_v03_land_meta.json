      "window_t1": 119.685,
      "window_s": 5.204000000000008,
      "used_s": 5.2,
      "explorer": false,
      "quality": "Fast",
      "vo_land": "Two years later, in nineteen fifteen, Moseley was killed in the First World War at Gallipoli. He was twenty-seven."
    },
    {
      "id": "24_nobel_belief",
      "file": "24_nobel_belief_v01.mp4",
      "sha256": "3aeb196fc65da283785997d1166ae68aff81a5789e9921431dcc7686e5fcb939",
