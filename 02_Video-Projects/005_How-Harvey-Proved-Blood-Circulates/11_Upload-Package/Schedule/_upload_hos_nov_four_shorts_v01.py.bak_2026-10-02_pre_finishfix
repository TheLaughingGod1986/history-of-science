          const walk=(r,d=0)=>{
            if(!r||d>50||hit) return;
            for (const el of (r.querySelectorAll
              ? r.querySelectorAll('button,[role=tab]') : [])) {
              if ((el.innerText||'').trim()==='Visibility') {
