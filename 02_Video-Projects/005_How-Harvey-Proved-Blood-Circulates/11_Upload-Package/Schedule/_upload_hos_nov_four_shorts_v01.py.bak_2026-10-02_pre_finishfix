def studio_page(ctx):
    hos_pages = []
    for pg in ctx.pages:
        url = pg.url or ""
        if any(x in url for x in ("facebook.com", "instagram.com")):
            continue
        if "studio.youtube.com" in url:
            hos_pages.append(pg)
