{
  "name": "content-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "worker": "tsx src/workers/publishing-worker.ts",
    "dev:all": "concurrently -k -n web,worker -c orange,cyan \"npm run dev\" \"npm run worker\"",
    "build": "node scripts/with-direct-url.mjs prisma generate && node scripts/with-direct-url.mjs prisma migrate deploy && next build",
    "postinstall": "node scripts/with-direct-url.mjs prisma generate",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "connections:validate": "tsx scripts/validate-connections.ts",
    "publishing:reconcile": "tsx scripts/reconcile-publishing-jobs.ts",
    "publishing:cleanup": "tsx scripts/cleanup-staged-media.ts",
    "youtube:upload": "tsx scripts/youtube-api-upload.ts",
    "youtube:package": "tsx --env-file=.env scripts/youtube-package-upload.ts",
    "generate:short-plan": "tsx scripts/generate-short-plan.ts",
    "generate:platform-copy": "tsx scripts/generate-platform-copy.ts",
    "create:export-package": "tsx scripts/create-export-package.ts",
    "import:performance": "tsx scripts/import-performance-data.ts",
    "review:script": "tsx scripts/review-script.ts",
    "diagnose:youtube": "tsx scripts/diagnose-youtube-growth.ts",
    "gate:episode": "tsx scripts/gate-episode.ts",
    "brief:next": "tsx scripts/next-episode-brief.ts",
    "affiliate:verify": "tsx scripts/affiliate-go-live.ts",
    "affiliate:apply-urls": "tsx scripts/apply-amazon-live-urls.ts",
    "affiliate:wire-topic-books": "tsx scripts/wire-topic-book-placements.ts",
    "verify:growth-v2": "vitest run tests/growth-system-v2.test.ts tests/episode-ops-v2.test.ts && tsx scripts/diagnose-youtube-growth.ts --file content/samples/json/youtube_growth_metrics_sample.json && tsx scripts/next-episode-brief.ts --file content/samples/json/youtube_growth_metrics_sample.json --out ../docs/NEXT_EPISODE_BRIEF.md",
    "lint:package": "tsx scripts/package-lint.ts",
    "channel:audit": "tsx --env-file=.env scripts/channel-audit.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "17.4.2",
    "next": "^16.4.6",
    "papaparse": "^5.5.4",
    "prisma": "7.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
