DATABASE_URL="file:./dev.db"
APP_BASE_URL=http://localhost:3000

# AES-256-GCM key (32 bytes, base64). Generate: openssl rand -base64 32
ORBIT_TOKEN_ENCRYPTION_KEY=

# Publishing
PUBLISHING_DRY_RUN=true
PUBLISHING_WORKER_ID=orbit-local-worker
MEDIA_STAGING_MODE=local_direct_upload
# MEDIA_PUBLIC_BASE_URL=https://your-bucket.example.com/orbit-staging

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Meta (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# Threads (optional — only if product approved)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback

# Optional integration tests (never on by default)
RUN_YOUTUBE_INTEGRATION_TESTS=false
RUN_META_INTEGRATION_TESTS=false
RUN_TIKTOK_INTEGRATION_TESTS=false
RUN_X_INTEGRATION_TESTS=false

# Affiliate Monetisation (never commit real IDs)
# Amazon Associates UK tag — applied at redirect time
AMAZON_ASSOCIATE_TAG=
# Brilliant referral / affiliate ID
BRILLIANT_AFFILIATE_ID=
# Redirect base for tracked links (production: https://orbitwithben.com/go)
# Defaults to ${APP_BASE_URL}/go when unset
AFFILIATE_REDIRECT_BASE_URL=
